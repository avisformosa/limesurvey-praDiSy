import psycopg2
import argparse

DB_CONFIG = {
    "dbname": "diagnostik",
    "user": "diagnostik_user",
    "password": "#IntroiboAdAltareDeiAdDeumQuiLaetificatAnimaMea#",
    "host": "localhost",
    "port": 5432
}

CREATE_PGCRYPTO_EXTENSION = "CREATE EXTENSION IF NOT EXISTS pgcrypto;"

CREATE_SURVEYS_TABLE = """
CREATE TABLE IF NOT EXISTS pradisy_surveys (
    survey_id SERIAL PRIMARY KEY,
    survey_name VARCHAR(150) NOT NULL,
    description TEXT,
    created_at TIMESTAMP DEFAULT now(),
    updated_at TIMESTAMP DEFAULT now()
);
"""

CREATE_PARTICIPANTS_TABLE = """
CREATE TABLE IF NOT EXISTS pradisy_participants (
    patient_id UUID PRIMARY KEY,
    name BYTEA NOT NULL,
    surname BYTEA NOT NULL,
    date_of_birth DATE NOT NULL,
    testperson BOOLEAN DEFAULT FALSE,
    mail BYTEA NOT NULL UNIQUE,
    created_at TIMESTAMP DEFAULT now(),
    updated_at TIMESTAMP DEFAULT now()
);
"""

CREATE_SURVEY_DATA_TABLE = """
CREATE TABLE IF NOT EXISTS pradisy_survey_data (
    data_id SERIAL PRIMARY KEY,
    instance_id INTEGER REFERENCES pradisy_surveys(survey_id) ON DELETE CASCADE,
    raw_data JSONB NOT NULL,
    results JSONB,
    created_at TIMESTAMP DEFAULT now(),
    updated_at TIMESTAMP DEFAULT now()
);
"""

def connect_db():
    return psycopg2.connect(**DB_CONFIG)

def create_pgcrypto_extension():
    conn = connect_db()
    with conn.cursor() as cursor:
        cursor.execute(CREATE_PGCRYPTO_EXTENSION)
    conn.commit()
    conn.close()

def create_surveys_table():
    conn = connect_db()
    with conn.cursor() as cursor:
        cursor.execute(CREATE_SURVEYS_TABLE)
    conn.commit()
    conn.close()

def create_participants_table():
    conn = connect_db()
    with conn.cursor() as cursor:
        cursor.execute(CREATE_PARTICIPANTS_TABLE)
    conn.commit()
    conn.close()

def create_survey_data_table():
    conn = connect_db()
    with conn.cursor() as cursor:
        cursor.execute(CREATE_SURVEY_DATA_TABLE)
    conn.commit()
    conn.close()

if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Verwalte die Datenbankstruktur in PostgreSQL.")
    parser.add_argument("--create-table", action="store_true", help="Erstellt die Tabellen für `pradisy`.")
    args = parser.parse_args()

    if args.create_table:
        create_pgcrypto_extension()
        create_surveys_table()
        create_participants_table()
        create_survey_data_table()
        print("Alle Tabellen wurden erfolgreich erstellt.")


