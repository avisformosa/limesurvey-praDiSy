   <row>
    <id><![CDATA[23]]></id>
    <gid><![CDATA[23]]></gid>
    <group_name><![CDATA[Persönlichkeits-Stil- und Störungs-Inventar (PSSI)]]></group_name>
    <description><![CDATA[<strong>Anleitung: </strong>Im folgenden finden Sie verschiedene Aussagen die mal mehr mal weniger Ihrem Erleben oder Verhalten entsprechen können. Versuchen Sie die fragen intuitiv auf ihr Zutreffen zu beurteilen von <em>Trifft gar nicht</em> = 0, T<em>rifft etwas zu</em> = 1, <em>Trifft überwiegend zu</em> = 2 und <em>Trifft ausgesprochen zu</em> = 3:<br /><br /><br /> ]]></description>
    <language><![CDATA[de]]></language>
    <sid><![CDATA[787794]]></sid>
    <group_order><![CDATA[9]]></group_order>
    <randomization_group/>
    <grelevance/>
   </row>
  </rows>
