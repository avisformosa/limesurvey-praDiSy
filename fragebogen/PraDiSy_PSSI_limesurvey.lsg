   </row>
   <row>
    <qid><![CDATA[504]]></qid>
    <parent_qid><![CDATA[364]]></parent_qid>
    <sid><![CDATA[787794]]></sid>
    <gid><![CDATA[23]]></gid>
    <type><![CDATA[T]]></type>
