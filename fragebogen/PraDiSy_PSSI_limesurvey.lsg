   <fieldname>language</fieldname>
  </fields>
  <rows>
   <row>
    <id><![CDATA[365]]></id>
    <qid><![CDATA[365]]></qid>
    <question><![CDATA[Viele Menschen nützen es aus, wenn man Schwäche zeigt.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[364]]></id>
    <qid><![CDATA[364]]></qid>
    <question/>
    <help/>
    <script/>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[366]]></id>
    <qid><![CDATA[366]]></qid>
    <question><![CDATA[Intimität zu anderen Menschen ist mir eher unangenehm.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[367]]></id>
    <qid><![CDATA[367]]></qid>
    <question><![CDATA[Ich habe schon öfter Eingebungen gehabt.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[368]]></id>
    <qid><![CDATA[368]]></qid>
    <question><![CDATA[Ich spüre oft eine innere Leere.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[369]]></id>
    <qid><![CDATA[369]]></qid>
    <question><![CDATA[Ich kann Menschen für mich einnehmen, wenn ich es will.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[370]]></id>
    <qid><![CDATA[370]]></qid>
    <question><![CDATA[Ich habe als Kind oft das Gefühl gehabt, etwas Besonderes zu sein.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[371]]></id>
    <qid><![CDATA[371]]></qid>
    <question><![CDATA[Eine Position, in der ich allein für den Erfolg einer Aufgabe verantwortlich bin, würde mir Angst machen.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[372]]></id>
    <qid><![CDATA[372]]></qid>
    <question><![CDATA[Wenn ich ganz allein bin, fühle ich mich oft hilflos.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[373]]></id>
    <qid><![CDATA[373]]></qid>
    <question><![CDATA[Ich bin ein Mensch mit festen Gewohnheiten.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[374]]></id>
    <qid><![CDATA[374]]></qid>
    <question><![CDATA[Ich fühle mich von anderen oft missverstanden.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[375]]></id>
    <qid><![CDATA[375]]></qid>
    <question><![CDATA[Ich fühle mich oft niedergeschlagen und kraftlos.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[376]]></id>
    <qid><![CDATA[376]]></qid>
    <question><![CDATA[Wenn ich etwas falsch mache, habe ich ein schlechtes Gewissen.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[377]]></id>
    <qid><![CDATA[377]]></qid>
    <question><![CDATA[Ich drücke meine Gefühle anderen gegenüber sehr spontan aus.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[378]]></id>
    <qid><![CDATA[378]]></qid>
    <question><![CDATA[Meine Bedürfnisse lebe ich aus, auch wenn andere zurückstecken müssen.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[379]]></id>
    <qid><![CDATA[379]]></qid>
    <question><![CDATA[Auf die meisten Menschen kann man sich verlassen, wenn man ihnen Vertrauen schenkt.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[380]]></id>
    <qid><![CDATA[380]]></qid>
    <question><![CDATA[Ich wahre immer die Distanz zu anderen Menschen.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[381]]></id>
    <qid><![CDATA[381]]></qid>
    <question><![CDATA[Ich spüre die Bedürfnisse anderer oft eher, als sie sie selbst bemerken.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[382]]></id>
    <qid><![CDATA[382]]></qid>
    <question><![CDATA[Wenn ich jemanden sehr mag, mache ich mir Sorgen, dass die Sympathie nicht lange hält.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[383]]></id>
    <qid><![CDATA[383]]></qid>
    <question><![CDATA[Ich kann sehr charmant sein.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[384]]></id>
    <qid><![CDATA[384]]></qid>
    <question><![CDATA[Wenn andere nicht auf meine Wünsche eingehen, kann ich böse werden.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[385]]></id>
    <qid><![CDATA[385]]></qid>
    <question><![CDATA[Viele Seiten von mir zeige ich nicht, weil ich befürchte, dass ich die Sympathie mancher Menschen verlieren würde.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[386]]></id>
    <qid><![CDATA[386]]></qid>
    <question><![CDATA[Ich lehne mich gern an eine starke Person an.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[387]]></id>
    <qid><![CDATA[387]]></qid>
    <question><![CDATA[Meine Gründlichkeit kann ich auch dann nicht ablegen,. wenn ich unter Zeitdruck stehe.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[388]]></id>
    <qid><![CDATA[388]]></qid>
    <question><![CDATA[Viele Menschen haben es nicht verdient, dass sie im Leben so viel Glück haben.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[389]]></id>
    <qid><![CDATA[389]]></qid>
    <question><![CDATA[Ich habe oft Schuldgefühle.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[390]]></id>
    <qid><![CDATA[390]]></qid>
    <question><![CDATA[Ich fühle mich wohl, wenn ich für jemanden sorgen kann.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[391]]></id>
    <qid><![CDATA[391]]></qid>
    <question><![CDATA[Ich kann mich jeden Tag für irgendwelche Dinge oder Menschen begeistern.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[392]]></id>
    <qid><![CDATA[392]]></qid>
    <question><![CDATA[Wenn andere etwas haben möchten, was ich brauche, setze ich mich meist durch.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[393]]></id>
    <qid><![CDATA[393]]></qid>
    <question><![CDATA[Ein gewisses Misstrauen gegenüber anderen ist oft angebracht.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[394]]></id>
    <qid><![CDATA[394]]></qid>
    <question><![CDATA[Ich lasse andere nicht gern an mich heran.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[395]]></id>
    <qid><![CDATA[395]]></qid>
    <question><![CDATA[Ich glaube, dass andere manchmal meine Gefühle spüren, auch wenn sie sich anderswo aufhalten.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[396]]></id>
    <qid><![CDATA[396]]></qid>
    <question><![CDATA[Oft kann ich selbst bei kleinen Enttäuschungen meine Wut kaum noch kontrollieren.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[397]]></id>
    <qid><![CDATA[397]]></qid>
    <question><![CDATA[Ich habe ein lebhaftes Temperament.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[398]]></id>
    <qid><![CDATA[398]]></qid>
    <question><![CDATA[Wenn ich im Beruf Ideen einbringe, erwarte ich, das sie von anderen anstandslos akzeptiert werden.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[399]]></id>
    <qid><![CDATA[399]]></qid>
    <question><![CDATA[Kritik tut mir schneller weh als anderen.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[400]]></id>
    <qid><![CDATA[400]]></qid>
    <question><![CDATA[Ich bin sehr bemüht, es Menschen, die mir wichtig sind, recht zu machen.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[401]]></id>
    <qid><![CDATA[401]]></qid>
    <question><![CDATA[Beständigkeit und feste Grundsätze bestimmen mein Leben.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[402]]></id>
    <qid><![CDATA[402]]></qid>
    <question><![CDATA[Ich bin in meinem Leben oft ungerecht behandelt worden.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[403]]></id>
    <qid><![CDATA[403]]></qid>
    <question><![CDATA[Wenn ich eine gute Idee habe, habe ich auch die Energie, sie umzusetzen.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[404]]></id>
    <qid><![CDATA[404]]></qid>
    <question><![CDATA[Man kann mich leicht ausnutzen.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[405]]></id>
    <qid><![CDATA[405]]></qid>
    <question><![CDATA[Mein Optimismus ist unbesiegbar.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[406]]></id>
    <qid><![CDATA[406]]></qid>
    <question><![CDATA[Wenn sich jemand mir gegenüber ablehnend verhält, kann ich ihn ohne weiteres fertigmachen.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[407]]></id>
    <qid><![CDATA[407]]></qid>
    <question><![CDATA[Es gibt viele ehrliche und offene Menschen.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[408]]></id>
    <qid><![CDATA[408]]></qid>
    <question><![CDATA[Ich bin gern mit anderen Menschen zusammen.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[409]]></id>
    <qid><![CDATA[409]]></qid>
    <question><![CDATA[Ich glaube, dass Strahlung das Denken und Fühlen der Menschen beeinflussen.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[410]]></id>
    <qid><![CDATA[410]]></qid>
    <question><![CDATA[Meine Selbstachtung kann abrupt zwischen sehr positiven und sehr negativen Empfindungen wechseln.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[411]]></id>
    <qid><![CDATA[411]]></qid>
    <question><![CDATA[Wenn ich unter Menschen bin, wirke ich meist sehr lebhaft.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[412]]></id>
    <qid><![CDATA[412]]></qid>
    <question><![CDATA[Ich habe ein ausgeprägtes Gefühl für das Besondere.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[413]]></id>
    <qid><![CDATA[413]]></qid>
    <question><![CDATA[Was andere von mit denken, berührt mich wenig.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[414]]></id>
    <qid><![CDATA[414]]></qid>
    <question><![CDATA[In der Partnerschaft brauche ich viel Bestätigung, wirklich geliebt zu werden.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[415]]></id>
    <qid><![CDATA[415]]></qid>
    <question><![CDATA[Pflichtbewusstsein geht für mich vor persönlichem Vergnügen.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[416]]></id>
    <qid><![CDATA[416]]></qid>
    <question><![CDATA[Andere Menschen bezeichnen mich zuweilen als zynisch.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[417]]></id>
    <qid><![CDATA[417]]></qid>
    <question><![CDATA[Ich finde es oft mühsam und anstrengend, bei einem Vorsatz zu bleiben.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[418]]></id>
    <qid><![CDATA[418]]></qid>
    <question><![CDATA[Ich bin oft an Menschen geraten, die meine Gutmütigkeit ausgenutzt haben.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[419]]></id>
    <qid><![CDATA[419]]></qid>
    <question><![CDATA[Viele Menschen mögen mich sehr, weil ich überall Sonnenschein verbreite.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[420]]></id>
    <qid><![CDATA[420]]></qid>
    <question><![CDATA[Ich mache, was mir Spaß macht, ohne Rücksicht auf andere.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[421]]></id>
    <qid><![CDATA[421]]></qid>
    <question><![CDATA[Es gibt viele Leute, die mit der unschuldigsten Miene, andere Menschen hintergehen.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[422]]></id>
    <qid><![CDATA[422]]></qid>
    <question><![CDATA[Andere halten mich häufig für kühl.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[423]]></id>
    <qid><![CDATA[423]]></qid>
    <question><![CDATA[Es gibt viele Dinge, die man mit dem Verstand nicht erklären kann.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[424]]></id>
    <qid><![CDATA[424]]></qid>
    <question><![CDATA[Meine Gefühle wechseln oft abrupt und impulsiv.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[425]]></id>
    <qid><![CDATA[425]]></qid>
    <question><![CDATA[Ich gehe sehr spontan auf andere Menschen zu.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[426]]></id>
    <qid><![CDATA[426]]></qid>
    <question><![CDATA[Der Gedanke, eine berühmte Persönlichkeit zu sein, reizt mich.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[427]]></id>
    <qid><![CDATA[427]]></qid>
    <question><![CDATA[Wenn mir eine Schwäche bewusst wird, kann mich das eine ganze Zeit belasten.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[428]]></id>
    <qid><![CDATA[428]]></qid>
    <question><![CDATA[In der Partnerschaft habe ich oft große Angst, verlassen zu werden.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[429]]></id>
    <qid><![CDATA[429]]></qid>
    <question><![CDATA[Dinge, die ich öfter tun muss, erledige ich gern immer nach dem selben Muster.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[430]]></id>
    <qid><![CDATA[430]]></qid>
    <question><![CDATA[Dass ich Versprechen öfter nicht einhalte, müssen andere hinnehmen.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[431]]></id>
    <qid><![CDATA[431]]></qid>
    <question><![CDATA[Auch in den schwierigsten Lebenslagen ist in mir immer die Sicherheit, dass alles gut wird.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[432]]></id>
    <qid><![CDATA[432]]></qid>
    <question><![CDATA[Wenn andere mich brauchen, bin ich immer zum Helfen bereit.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[433]]></id>
    <qid><![CDATA[433]]></qid>
    <question><![CDATA[Am liebsten bin ich mit Leuten zusammen, mit denen ich immerzu lachen und ulkige Sachen machen kann.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[434]]></id>
    <qid><![CDATA[434]]></qid>
    <question><![CDATA[Wenn sich Leute gegen mich wenden, kann ich sie fertig machen.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[435]]></id>
    <qid><![CDATA[435]]></qid>
    <question><![CDATA[Die meisten Menschen verfolgen gute Absichten.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[436]]></id>
    <qid><![CDATA[436]]></qid>
    <question><![CDATA[Ich mag die Nähe anderer Menschen.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[437]]></id>
    <qid><![CDATA[437]]></qid>
    <question><![CDATA[Manchmal spüre ich die Anwesenheit einer fernen Person so stark, als wäre sie wirklich da.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[438]]></id>
    <qid><![CDATA[438]]></qid>
    <question><![CDATA[Manchmal habe ich das Gefühl, als könnte mein Leben völlig aus der Bahn geraten.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[439]]></id>
    <qid><![CDATA[439]]></qid>
    <question><![CDATA[Meine gute Laune überträgt sich oft auf andere.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[440]]></id>
    <qid><![CDATA[440]]></qid>
    <question><![CDATA[Ich kann es nicht haben, wenn andere mich nicht verstehen.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[441]]></id>
    <qid><![CDATA[441]]></qid>
    <question><![CDATA[Wenn ich mich beobachtet fühle, werde ich ängstlich.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[442]]></id>
    <qid><![CDATA[442]]></qid>
    <question><![CDATA[Es tut mir gut, einen Menschen um mich zu haben, der ein wenig für mich sorgt.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[443]]></id>
    <qid><![CDATA[443]]></qid>
    <question><![CDATA[Fehler, die auf Unachtsamkeit schließen lassen, stören mich sehr.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[444]]></id>
    <qid><![CDATA[444]]></qid>
    <question><![CDATA[Bei Menschen, die zunächst sympathisch wirken, sehe ich sehr schnell auch die negativen Seiten.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[445]]></id>
    <qid><![CDATA[445]]></qid>
    <question><![CDATA[Mir schwindet oft die Hoffnung, dass Dinge, die mir nicht gefallen, je anders werden.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[446]]></id>
    <qid><![CDATA[446]]></qid>
    <question><![CDATA[Es gibt mir mehr Sinn, Leid zu lindern, als mein persönliches Glück zu suchen.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[447]]></id>
    <qid><![CDATA[447]]></qid>
    <question><![CDATA[Wo ich auch hinkomme, verbreite ich gute Laune.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[448]]></id>
    <qid><![CDATA[448]]></qid>
    <question><![CDATA[Ich greife lieber an, als angreifen zu lassen.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[449]]></id>
    <qid><![CDATA[449]]></qid>
    <question><![CDATA[Ich traue manchmal meinen Freunden nicht mehr.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[450]]></id>
    <qid><![CDATA[450]]></qid>
    <question><![CDATA[Ich drücke meine Gefühle meist ganz spontan aus.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[451]]></id>
    <qid><![CDATA[451]]></qid>
    <question><![CDATA[Wenn Vernunft und Erfahrung nicht weiterhelfen, gibt es immer noch eine innere Stimme, die mir sagt, was zu tun ist.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[452]]></id>
    <qid><![CDATA[452]]></qid>
    <question><![CDATA[Ich habe oft ohne Grund ängstliche Gefühle.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[453]]></id>
    <qid><![CDATA[453]]></qid>
    <question><![CDATA[Ich weiß sehr gut, wie ich beim anderen Geschlecht Interesse für mich wecken kann.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[454]]></id>
    <qid><![CDATA[454]]></qid>
    <question><![CDATA[Oft wünsche ich mir, dass mehr Menschen das Besondere an mir sehen.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[455]]></id>
    <qid><![CDATA[455]]></qid>
    <question><![CDATA[Ich kann es gut verkraften, dass manche Menschen mich nicht mögen.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[456]]></id>
    <qid><![CDATA[456]]></qid>
    <question><![CDATA[Ich bin ein sehr anhänglicher Mensch.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[457]]></id>
    <qid><![CDATA[457]]></qid>
    <question><![CDATA[Ich mag es nicht, wenn jemand Vorschriften missachtet.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[458]]></id>
    <qid><![CDATA[458]]></qid>
    <question><![CDATA[Andere erkennen meine Leistungen oft nicht hinreichend an.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[459]]></id>
    <qid><![CDATA[459]]></qid>
    <question><![CDATA[Ich fühle mich oft unzulänglich und wertlos.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[460]]></id>
    <qid><![CDATA[460]]></qid>
    <question><![CDATA[Wenn andere mich um Hilfe bitten, fällt es mir schwer, abzulehnen.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[461]]></id>
    <qid><![CDATA[461]]></qid>
    <question><![CDATA[Selbst die schwierigsten Dinge im Leben können meine Fröhlichkeit nicht bremsen.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[462]]></id>
    <qid><![CDATA[462]]></qid>
    <question><![CDATA[Wenn andere mir Schwierigkeiten machen, kann ich sehr ungemütlich werden.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[463]]></id>
    <qid><![CDATA[463]]></qid>
    <question><![CDATA[Ich kenne viele Menschen, denen ich voll und ganz vertrauen kann.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[464]]></id>
    <qid><![CDATA[464]]></qid>
    <question><![CDATA[Probleme löse ich lieber durch eigenes Nachdenken, als durch Gespräche.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[465]]></id>
    <qid><![CDATA[465]]></qid>
    <question><![CDATA[Es gibt so etwas wie den 6. Sinn.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[466]]></id>
    <qid><![CDATA[466]]></qid>
    <question><![CDATA[Ich ärgere mich oft über Gefühle, die in mir aufkommen.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[467]]></id>
    <qid><![CDATA[467]]></qid>
    <question><![CDATA[Ich gelte als attraktiv.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[468]]></id>
    <qid><![CDATA[468]]></qid>
    <question><![CDATA[Ich träume nicht von großen Erfolgen.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[469]]></id>
    <qid><![CDATA[469]]></qid>
    <question><![CDATA[Ich kann in der Gesellschaft durchaus selbstsicher auftreten.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[470]]></id>
    <qid><![CDATA[470]]></qid>
    <question><![CDATA[Ich brauche sehr viel Liebe und Angenommensein.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[471]]></id>
    <qid><![CDATA[471]]></qid>
    <question><![CDATA[Ich bin ein gewissenhafter Mensch.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[472]]></id>
    <qid><![CDATA[472]]></qid>
    <question><![CDATA[Ich bin in meinem Leben oft vom Pech verfolgt worden.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[473]]></id>
    <qid><![CDATA[473]]></qid>
    <question><![CDATA[Über die meisten Dinge im Leben grüble ich nicht lange nach.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[474]]></id>
    <qid><![CDATA[474]]></qid>
    <question><![CDATA[Es fällt mir leichter, an andere als an mich selbst zu denken.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[475]]></id>
    <qid><![CDATA[475]]></qid>
    <question><![CDATA[Wenn ich unter Menschen bin, bin ich praktisch immer gut aufgelegt.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[476]]></id>
    <qid><![CDATA[476]]></qid>
    <question><![CDATA[Schwache Menschen fassen mein Durchsetzungsvermögen als Rücksichtslosigkeit auf.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[477]]></id>
    <qid><![CDATA[477]]></qid>
    <question><![CDATA[Es gibt wenig wirklich gerechte Menschen.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[478]]></id>
    <qid><![CDATA[478]]></qid>
    <question><![CDATA[Auch wenn etwas besonders Schönes passiert, bleibe ich meist gelassen.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[479]]></id>
    <qid><![CDATA[479]]></qid>
    <question><![CDATA[Ich glaube an Gedankenübertragung.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[480]]></id>
    <qid><![CDATA[480]]></qid>
    <question><![CDATA[Ich habe schon einmal den Impuls gespürt, mich zu verletzen.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[481]]></id>
    <qid><![CDATA[481]]></qid>
    <question><![CDATA[Ich habe auf das andere Geschlecht eine besondere Anziehungskraft.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[482]]></id>
    <qid><![CDATA[482]]></qid>
    <question><![CDATA[Im Mittelpunkt zu stehen, hat für mich einen besonderen Reiz.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[483]]></id>
    <qid><![CDATA[483]]></qid>
    <question><![CDATA[Vor vielen Menschen zu sprechen, fällt mir schwer.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[484]]></id>
    <qid><![CDATA[484]]></qid>
    <question><![CDATA[Ob ich mich als wertvollen Menschen erlebe, hängt davon ab, wie andere Menschen auf mich zugehen.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[485]]></id>
    <qid><![CDATA[485]]></qid>
    <question><![CDATA[Genauigkeit und Ordnung sind mit sehr wichtig.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[486]]></id>
    <qid><![CDATA[486]]></qid>
    <question><![CDATA[Es gibt viele Menschen, die ich nicht ausstehen kann.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[487]]></id>
    <qid><![CDATA[487]]></qid>
    <question><![CDATA[Ich bin oft wütend auf mich selbst.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[488]]></id>
    <qid><![CDATA[488]]></qid>
    <question><![CDATA[Manchmal geht es mir schlecht, weil ich mir das Leid zu vieler Menschen zu Herzen nehme.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[489]]></id>
    <qid><![CDATA[489]]></qid>
    <question><![CDATA[Das Leben ist voller Wunder und herrlicher Überraschungen.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[490]]></id>
    <qid><![CDATA[490]]></qid>
    <question><![CDATA[Ich lasse mit von anderen nichts gefallen.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[491]]></id>
    <qid><![CDATA[491]]></qid>
    <question><![CDATA[Es gibt viele Menschen, die versuchen, Macht zu gewinnen, nur um andere zu kontrollieren.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[492]]></id>
    <qid><![CDATA[492]]></qid>
    <question><![CDATA[Wenn ein Mensch mir nahe sein will, fühle ich mich rasch eingeengt.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[493]]></id>
    <qid><![CDATA[493]]></qid>
    <question><![CDATA[Es gibt übernatürliche Kräfte.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[494]]></id>
    <qid><![CDATA[494]]></qid>
    <question><![CDATA[Wenn ich mich besonders nett verhalte, weiß ich manchmal nicht, ob das wirklich aus mir selber kommt.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[495]]></id>
    <qid><![CDATA[495]]></qid>
    <question><![CDATA[Der Umgang mit anderen Menschen liegt mir mehr, als die Bearbeitung nüchterner Sachaufgaben.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[496]]></id>
    <qid><![CDATA[496]]></qid>
    <question><![CDATA[Ich habe viele Träume und Ideale.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[497]]></id>
    <qid><![CDATA[497]]></qid>
    <question><![CDATA[Ich habe oft Gewissensbisse.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[498]]></id>
    <qid><![CDATA[498]]></qid>
    <question><![CDATA[Es tut mir gut, einen Menschen um mich zu haben, der mir sagt, wo es langgeht.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[499]]></id>
    <qid><![CDATA[499]]></qid>
    <question><![CDATA[Ich kann es nicht leiden, wenn andere ihren Pflichten nicht nachkommen.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[500]]></id>
    <qid><![CDATA[500]]></qid>
    <question><![CDATA[Meine Fehler und dunklen Seiten beschäftigen mich oft.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[501]]></id>
    <qid><![CDATA[501]]></qid>
    <question><![CDATA[Es gibt viele Dinge, über die ich mich freuen kann.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[502]]></id>
    <qid><![CDATA[502]]></qid>
    <question><![CDATA[Die Sorgen anderer beschäftigen mich mehr als meine eigenen Bedürfnisse.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[503]]></id>
    <qid><![CDATA[503]]></qid>
    <question><![CDATA[Ich kann mich jeden Tag, auch über kleine Dinge, wie ein Kind freuen.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[504]]></id>
    <qid><![CDATA[504]]></qid>
    <question><![CDATA[Wer mir schaden will, muss mit meiner Vergeltung rechnen.]]></question>
    <language><![CDATA[de]]></language>
   </row>
  </rows>
 </question_l10ns>
