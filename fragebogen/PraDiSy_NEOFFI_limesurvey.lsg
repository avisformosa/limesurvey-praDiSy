    <qid><![CDATA[506]]></qid>
    <question><![CDATA[Ich bin nicht leicht beunruhigt.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[505]]></id>
    <qid><![CDATA[505]]></qid>
    <question/>
    <help/>
    <script/>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[507]]></id>
    <qid><![CDATA[507]]></qid>
    <question><![CDATA[Ich habe gerne viele Leute um mich herum.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[508]]></id>
    <qid><![CDATA[508]]></qid>
    <question><![CDATA[Ich mag meine Zeit nicht mit Tagträumereien verschwenden.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[509]]></id>
    <qid><![CDATA[509]]></qid>
    <question><![CDATA[Ich versuche zu jedem, dem ich begegne, freundlich zu sein.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[510]]></id>
    <qid><![CDATA[510]]></qid>
    <question><![CDATA[Ich halte meine Sachen ordentlich und sauber.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[511]]></id>
    <qid><![CDATA[511]]></qid>
    <question><![CDATA[Ich fühle mich anderen oft unterlegen.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[512]]></id>
    <qid><![CDATA[512]]></qid>
    <question><![CDATA[Ich bin leicht zum Lachen zu bringen.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[513]]></id>
    <qid><![CDATA[513]]></qid>
    <question><![CDATA[Ich finde philosophische Diskussionen langweilig.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[514]]></id>
    <qid><![CDATA[514]]></qid>
    <question><![CDATA[Ich bekomme häufiger Streit mit meiner Familie und meinen Kollegen.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[515]]></id>
    <qid><![CDATA[515]]></qid>
    <question><![CDATA[Ich kann mir meine Zeit recht gut einteilen, so daß ich meine Angelegenheiten rechtzeitig beende]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[516]]></id>
    <qid><![CDATA[516]]></qid>
    <question><![CDATA[Wenn ich unter starkem Streß stehe, fühle ich mich manchmal, als ob ich zusammenbräche.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[517]]></id>
    <qid><![CDATA[517]]></qid>
    <question><![CDATA[Ich halte mich nicht für besonders fröhlich.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[518]]></id>
    <qid><![CDATA[518]]></qid>
    <question><![CDATA[Mich begeistern die Motive, die ich in der Kunst und in der Natur finde.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[519]]></id>
    <qid><![CDATA[519]]></qid>
    <question><![CDATA[Manche Leute halten mich für selbstsüchtig und selbstgefällig.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[520]]></id>
    <qid><![CDATA[520]]></qid>
    <question><![CDATA[Ich bin kein sehr systematisch vorgehender Mensch.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[521]]></id>
    <qid><![CDATA[521]]></qid>
    <question><![CDATA[Ich fühle mich selten einsam oder traurig.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[522]]></id>
    <qid><![CDATA[522]]></qid>
    <question><![CDATA[Ich unterhalte mich wirklich gerne mit anderen Menschen.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[523]]></id>
    <qid><![CDATA[523]]></qid>
    <question><![CDATA[Ich glaube, daß es Schüler oft verwirrt und irreführt, wenn man sie Rednern zuhören läßt, die kontroverse Standpunkte vertreten.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[524]]></id>
    <qid><![CDATA[524]]></qid>
    <question><![CDATA[Ich würde lieber mit anderen zusammenarbeiten, als mit ihnen zu wetteifern.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[525]]></id>
    <qid><![CDATA[525]]></qid>
    <question><![CDATA[Ich versuche, alle mir übertragenen Aufgaben sehr gewissenhaft zu erledigen.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[526]]></id>
    <qid><![CDATA[526]]></qid>
    <question><![CDATA[Ich fühle mich oft angespannt und nervös.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[527]]></id>
    <qid><![CDATA[527]]></qid>
    <question><![CDATA[Ich bin gerne im Zentrum des Geschehens.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[528]]></id>
    <qid><![CDATA[528]]></qid>
    <question><![CDATA[Poesie beeindruckt mich wenig oder gar nicht.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[529]]></id>
    <qid><![CDATA[529]]></qid>
    <question><![CDATA[Im Hinblick auf die Absichten anderer bin ich ehe zynisch und skeptisch.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[530]]></id>
    <qid><![CDATA[530]]></qid>
    <question><![CDATA[Ich habe eine Reihe von klaren Zielen und arbeite systematisch auf sie zu.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[531]]></id>
    <qid><![CDATA[531]]></qid>
    <question><![CDATA[Manchmal fühle ich mich völlig wertlos.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[532]]></id>
    <qid><![CDATA[532]]></qid>
    <question><![CDATA[Ich ziehe es gewöhnlich vor, Dinge allein zu tun.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[533]]></id>
    <qid><![CDATA[533]]></qid>
    <question><![CDATA[Ich probiere oft neue und fremde Speisen aus.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[534]]></id>
    <qid><![CDATA[534]]></qid>
    <question><![CDATA[Ich glaube, daß man von den meisten Leuten ausgenutzt wird, wenn man es zuläßt.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[535]]></id>
    <qid><![CDATA[535]]></qid>
    <question><![CDATA[Ich vertrödele eine Menge Zeit, bevor ich mit einer Arbeit beginnen]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[536]]></id>
    <qid><![CDATA[536]]></qid>
    <question><![CDATA[Ich empfinde selten Furcht oder Angst.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[537]]></id>
    <qid><![CDATA[537]]></qid>
    <question><![CDATA[Ich habe oft das Gefühl, vor Energie überzuschäumen.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[538]]></id>
    <qid><![CDATA[538]]></qid>
    <question><![CDATA[Ich nehme nur selten Notiz von den Stimmungen oder Gefühlen, die verschiedene Umgebungen hervorrufen.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[539]]></id>
    <qid><![CDATA[539]]></qid>
    <question><![CDATA[Die meisten Menschen, die ich kenne, mögen mich.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[540]]></id>
    <qid><![CDATA[540]]></qid>
    <question><![CDATA[Ich arbeite hart, um meine Ziele zu erreichen.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[541]]></id>
    <qid><![CDATA[541]]></qid>
    <question><![CDATA[Ich ärgere mich oft darüber, wie andere Leute mich behandeln.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[542]]></id>
    <qid><![CDATA[542]]></qid>
    <question><![CDATA[Ich bin ein fröhlicher, gut gelaunter  Mensch.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[543]]></id>
    <qid><![CDATA[543]]></qid>
    <question><![CDATA[Ich glaube, daß wir bei ethischen Entscheidungen auf die Ansichten unserer religiösen Autoritäten achten sollten.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[544]]></id>
    <qid><![CDATA[544]]></qid>
    <question><![CDATA[Manche Leute halten mich für kalt und berechnend.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[545]]></id>
    <qid><![CDATA[545]]></qid>
    <question><![CDATA[Wenn ich eine Verpflichtung eingehe, so kann man sich auf mich bestimmt verlasse.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[546]]></id>
    <qid><![CDATA[546]]></qid>
    <question><![CDATA[Zu häufig bin ich entmutigt und will aufgeben, wenn etwas schiefgeht.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[547]]></id>
    <qid><![CDATA[547]]></qid>
    <question><![CDATA[Ich bin kein gut gelaunter Optimist.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[548]]></id>
    <qid><![CDATA[548]]></qid>
    <question><![CDATA[Wenn ich Literatur lese oder ein Kunstwerk betrachte, empfinde ich manchmal ein Frösteln oder eine Welle der Begeisterung.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[549]]></id>
    <qid><![CDATA[549]]></qid>
    <question><![CDATA[In Bezug auf meine Einstellung bin ich nüchtern und unnachgiebig.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[550]]></id>
    <qid><![CDATA[550]]></qid>
    <question><![CDATA[Manchmal bin ich nicht so verläßlich oder zuverlässig, wie ich sein sollte.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[551]]></id>
    <qid><![CDATA[551]]></qid>
    <question><![CDATA[Ich bin selten traurig oder deprimiert.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[552]]></id>
    <qid><![CDATA[552]]></qid>
    <question><![CDATA[Ich führe ein hektisches Leben.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[553]]></id>
    <qid><![CDATA[553]]></qid>
    <question><![CDATA[Ich habe wenig Interesse, über die Natur des Universums oder die Lage der Menschheit zu spekulieren.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[554]]></id>
    <qid><![CDATA[554]]></qid>
    <question><![CDATA[Ich versuche stets rücksichtsvoll und sensibel zu handeln.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[555]]></id>
    <qid><![CDATA[555]]></qid>
    <question><![CDATA[Ich bin eine tüchtige Person, die ihre Arbeit immer erledigt.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[556]]></id>
    <qid><![CDATA[556]]></qid>
    <question><![CDATA[Ich fühle mich oft hilflos und wünsche mir eine Person, die meine Probleme löst.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[557]]></id>
    <qid><![CDATA[557]]></qid>
    <question><![CDATA[Ich bin ein sehr aktiver Mensch.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[558]]></id>
    <qid><![CDATA[558]]></qid>
    <question><![CDATA[Ich bin sehr wißbegierig.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[559]]></id>
    <qid><![CDATA[559]]></qid>
    <question><![CDATA[Wenn ich Menschen nicht mag, so zeige ich ihnen das auch offen.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[560]]></id>
    <qid><![CDATA[560]]></qid>
    <question><![CDATA[Ich werde wohl niemals fähig sein, Ordnung in mein Leben zu bringen.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[561]]></id>
    <qid><![CDATA[561]]></qid>
    <question><![CDATA[Manchmal war mir etwas so peinlich, daß ich mich am liebsten versteckt hätte.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[562]]></id>
    <qid><![CDATA[562]]></qid>
    <question><![CDATA[Lieber würde ich meine eigenen Wege gehen, als eine Gruppe anzuführen.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[563]]></id>
    <qid><![CDATA[563]]></qid>
    <question><![CDATA[Ich habe oft Spaß daran, mit Theorien oder abstrakten Ideen zu spielen.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[564]]></id>
    <qid><![CDATA[564]]></qid>
    <question><![CDATA[Um zu bekommen, was ich will, bin ich notfalls bereit, Menschen zu manipulieren.]]></question>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[565]]></id>
    <qid><![CDATA[565]]></qid>
    <question><![CDATA[Bei allem, was ich tue, strebe ich nach Perfektion.]]></question>
    <language><![CDATA[de]]></language>
   </row>
  </rows>
 </question_l10ns>
