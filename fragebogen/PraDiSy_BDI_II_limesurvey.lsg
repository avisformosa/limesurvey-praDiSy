  <rows>
   <row>
    <id><![CDATA[42]]></id>
    <aid><![CDATA[42]]></aid>
    <answer><![CDATA[Ich glaube, dass meine Zukunft hoffnungslos ist und nur noch schlechter wird]]></answer>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[41]]></id>
    <aid><![CDATA[41]]></aid>
    <answer><![CDATA[Ich bin mutlos und erwarte nicht, dass meine Situation besser wird]]></answer>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[40]]></id>
    <aid><![CDATA[40]]></aid>
    <answer><![CDATA[Ich sehe mutloser in die Zukunft als sonst]]></answer>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[39]]></id>
    <aid><![CDATA[39]]></aid>
    <answer><![CDATA[Ich sehe nicht mutlos in die Zukunft]]></answer>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[38]]></id>
    <aid><![CDATA[38]]></aid>
    <answer><![CDATA[Ich bin so traurig oder unglücklich, dass ich es nicht aushalte]]></answer>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[37]]></id>
    <aid><![CDATA[37]]></aid>
    <answer><![CDATA[Ich bin ständig traurig]]></answer>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[36]]></id>
    <aid><![CDATA[36]]></aid>
    <answer><![CDATA[Ich bin oft traurig]]></answer>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[35]]></id>
    <aid><![CDATA[35]]></aid>
    <answer><![CDATA[Ich bin nicht traurig]]></answer>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[56]]></id>
    <aid><![CDATA[56]]></aid>
    <answer><![CDATA[Ich kann die Dinge nicht mehr so genießen wie früher]]></answer>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[55]]></id>
    <aid><![CDATA[55]]></aid>
    <answer><![CDATA[Ich kann die Dinge genauso gut genießen wie früher]]></answer>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[54]]></id>
    <aid><![CDATA[54]]></aid>
    <answer><![CDATA[Ich habe das Gefühl, als Mensch ein völliger Versager zu sein]]></answer>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[53]]></id>
    <aid><![CDATA[53]]></aid>
    <answer><![CDATA[Wenn ich zurückblicke, sehe ich eine Menge Fehlschläge]]></answer>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[52]]></id>
    <aid><![CDATA[52]]></aid>
    <answer><![CDATA[Ich habe häufiger Versagensgefühle]]></answer>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[51]]></id>
    <aid><![CDATA[51]]></aid>
    <answer><![CDATA[Ich fühle mich nicht als Versager]]></answer>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[63]]></id>
    <aid><![CDATA[63]]></aid>
    <answer><![CDATA[Ich habe nicht das Gefühl, für etwas bestraft zu sein]]></answer>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[62]]></id>
    <aid><![CDATA[62]]></aid>
    <answer><![CDATA[Ich habe ständig Schuldgefühle]]></answer>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[61]]></id>
    <aid><![CDATA[61]]></aid>
    <answer><![CDATA[Ich habe die meiste Zeit Schuldgefühle]]></answer>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[60]]></id>
    <aid><![CDATA[60]]></aid>
    <answer><![CDATA[Ich habe oft Schuldgefühle wegen Dingen, die ich getan habe oder hätte tun sollen]]></answer>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[59]]></id>
    <aid><![CDATA[59]]></aid>
    <answer><![CDATA[Ich habe keine besonderen Schuldgefühle]]></answer>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[58]]></id>
    <aid><![CDATA[58]]></aid>
    <answer><![CDATA[Dinge, die mir früher Freude gemacht haben, kann ich überhaupt nicht mehr genießen]]></answer>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[57]]></id>
    <aid><![CDATA[57]]></aid>
    <answer><![CDATA[Dinge, die mir früher Freude gemacht haben, kann ich kaum mehr genießen]]></answer>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[64]]></id>
    <aid><![CDATA[64]]></aid>
    <answer><![CDATA[Ich habe das Gefühl, vielleicht bestraft zu werden]]></answer>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[65]]></id>
    <aid><![CDATA[65]]></aid>
    <answer><![CDATA[Ich erwarte, bestraft zu werden]]></answer>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[66]]></id>
    <aid><![CDATA[66]]></aid>
    <answer><![CDATA[Ich habe das Gefühl, bestraft zu sein]]></answer>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[67]]></id>
    <aid><![CDATA[67]]></aid>
    <answer><![CDATA[Ich halte von mir genauso viel wie immer]]></answer>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[68]]></id>
    <aid><![CDATA[68]]></aid>
    <answer><![CDATA[Ich habe Vertrauen in mich verloren]]></answer>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[69]]></id>
    <aid><![CDATA[69]]></aid>
    <answer><![CDATA[Ich bin von mir enttäuscht]]></answer>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[70]]></id>
    <aid><![CDATA[70]]></aid>
    <answer><![CDATA[Ich lehne mich völlig ab]]></answer>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[79]]></id>
    <aid><![CDATA[79]]></aid>
    <answer><![CDATA[Ich kritisiere oder tadle mich nicht mehr als sonst]]></answer>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[80]]></id>
    <aid><![CDATA[80]]></aid>
    <answer><![CDATA[Ich bin mir gegenüber kritischer als sonst]]></answer>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[81]]></id>
    <aid><![CDATA[81]]></aid>
    <answer><![CDATA[Ich kritisiere mich für all meine Mängel]]></answer>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[82]]></id>
    <aid><![CDATA[82]]></aid>
    <answer><![CDATA[Ich gebe mir die Schuld für alles Schlimme, was passiert]]></answer>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[83]]></id>
    <aid><![CDATA[83]]></aid>
    <answer><![CDATA[Ich denke nicht daran, mir etwas anzutun]]></answer>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[84]]></id>
    <aid><![CDATA[84]]></aid>
    <answer><![CDATA[Ich denke manchmal an Selbstmord, aber ich würde es nicht tun]]></answer>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[85]]></id>
    <aid><![CDATA[85]]></aid>
    <answer><![CDATA[Ich möchte mich am liebsten umbringen]]></answer>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[86]]></id>
    <aid><![CDATA[86]]></aid>
    <answer><![CDATA[Ich würde mich umbringen, wenn ich die Gelegenheit dazu hätte]]></answer>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[87]]></id>
    <aid><![CDATA[87]]></aid>
    <answer><![CDATA[Ich weine nicht öfter als früher]]></answer>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[88]]></id>
    <aid><![CDATA[88]]></aid>
    <answer><![CDATA[Ich weine jetzt mehr als früher]]></answer>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[89]]></id>
    <aid><![CDATA[89]]></aid>
    <answer><![CDATA[Ich weine beim geringsten Anlass]]></answer>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[90]]></id>
    <aid><![CDATA[90]]></aid>
    <answer><![CDATA[Ich möchte gern weinen, aber ich kann nicht]]></answer>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[91]]></id>
    <aid><![CDATA[91]]></aid>
    <answer><![CDATA[Ich bin nicht unruhiger als sonst]]></answer>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[92]]></id>
    <aid><![CDATA[92]]></aid>
    <answer><![CDATA[Ich bin unruhiger als sonst]]></answer>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[93]]></id>
    <aid><![CDATA[93]]></aid>
    <answer><![CDATA[Ich bin so unruhig, dass es mir schwerfällt, stillzusitzen]]></answer>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[94]]></id>
    <aid><![CDATA[94]]></aid>
    <answer><![CDATA[Ich bin so unruhig, dass ich mich ständig bewegen oder etwas tun muss]]></answer>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[95]]></id>
    <aid><![CDATA[95]]></aid>
    <answer><![CDATA[Ich habe das Interesse an anderen Menschen oder an Tätigkeiten nicht verloren]]></answer>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[96]]></id>
    <aid><![CDATA[96]]></aid>
    <answer><![CDATA[Ich habe weniger Interesse an anderen Menschen oder an Dingen als sonst]]></answer>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[97]]></id>
    <aid><![CDATA[97]]></aid>
    <answer><![CDATA[Ich habe das Interesse an anderen Menschen oder an Dingen zum größten Teil verloren]]></answer>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[98]]></id>
    <aid><![CDATA[98]]></aid>
    <answer><![CDATA[Es fällt mir schwer, mich überhaupt für irgend etwas zu interessieren]]></answer>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[99]]></id>
    <aid><![CDATA[99]]></aid>
    <answer><![CDATA[Ich bin so entschlussfreudig wie immer]]></answer>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[100]]></id>
    <aid><![CDATA[100]]></aid>
    <answer><![CDATA[Es fällt mir schwerer als sonst, Entscheidungen zu treffen]]></answer>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[101]]></id>
    <aid><![CDATA[101]]></aid>
    <answer><![CDATA[Es fällt mir sehr viel schwerer als sonst, Entscheidungen zu treffen]]></answer>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[102]]></id>
    <aid><![CDATA[102]]></aid>
    <answer><![CDATA[Ich habe Mühe, überhaupt Entscheidungen zu treffen]]></answer>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[103]]></id>
    <aid><![CDATA[103]]></aid>
    <answer><![CDATA[Ich fühle mich nicht wertlos]]></answer>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[104]]></id>
    <aid><![CDATA[104]]></aid>
    <answer><![CDATA[Ich halte mich für weniger wertvoll und nützlich als sonst]]></answer>
    <language><![CDATA[de]]></language>
   </row>
   <row>
    <id><![CDATA[105]]></id>
    <aid><![CDATA[105]]></aid>
