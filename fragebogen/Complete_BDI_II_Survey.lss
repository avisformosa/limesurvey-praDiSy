<?xml version='1.0' encoding='utf-8'?>
<document><Limesurvey><Survey><SurveyInfo><Title>BDI-II Survey</Title></SurveyInfo><QuestionGroup><GroupName>Beck Depression Inventory-II</GroupName><Question><Title>Traurigkeit</Title><Type>Multiple Choice</Type><AnswerOptions><Option><Text>Ich bin nicht traurig</Text><Value>0</Value></Option><Option><Text>Ich bin oft traurig</Text><Value>1</Value></Option><Option><Text>Ich bin ständig traurig</Text><Value>2</Value></Option><Option><Text>Ich bin so traurig oder unglücklich, dass ich es nicht aushalte</Text><Value>3</Value></Option></AnswerOptions></Question><Question><Title>Pessimismus</Title><Type>Multiple Choice</Type><AnswerOptions><Option><Text>Ich sehe nicht mutlos in die Zukunft</Text><Value>0</Value></Option><Option><Text>Ich sehe mutloser in die Zukunft als sonst</Text><Value>1</Value></Option><Option><Text>Ich bin mutlos und erwarte nicht, dass meine Situation besser wird</Text><Value>2</Value></Option><Option><Text>Ich glaube, dass meine Zukunft hoffnungslos ist und nur noch schlechter wird</Text><Value>3</Value></Option></AnswerOptions></Question><Question><Title>Versagensgefühle</Title><Type>Multiple Choice</Type><AnswerOptions><Option><Text>Ich fühle mich nicht als Versager</Text><Value>0</Value></Option><Option><Text>Ich habe häufiger Versagensgefühle</Text><Value>1</Value></Option><Option><Text>Wenn ich zurückblicke, sehe ich eine Menge Fehlschläge</Text><Value>2</Value></Option><Option><Text>Ich habe das Gefühl, als Mensch ein völliger Versager zu sein</Text><Value>3</Value></Option></AnswerOptions></Question><Question><Title>Verlust von Freude</Title><Type>Multiple Choice</Type><AnswerOptions><Option><Text>Ich kann die Dinge genauso gut genießen wie früher</Text><Value>0</Value></Option><Option><Text>Ich kann die Dinge nicht mehr so genießen wie früher</Text><Value>1</Value></Option><Option><Text>Dinge, die mir früher Freude gemacht haben, kann ich kaum mehr genießen</Text><Value>2</Value></Option><Option><Text>Dinge, die mir früher Freude gemacht haben, kann ich überhaupt nicht mehr genießen</Text><Value>3</Value></Option></AnswerOptions></Question><Question><Title>Schuldgefühle</Title><Type>Multiple Choice</Type><AnswerOptions><Option><Text>Ich habe keine besonderen Schuldgefühle</Text><Value>0</Value></Option><Option><Text>Ich habe oft Schuldgefühle wegen Dingen, die ich getan habe oder hätte tun sollen</Text><Value>1</Value></Option><Option><Text>Ich habe die meiste Zeit Schuldgefühle</Text><Value>2</Value></Option><Option><Text>Ich habe ständig Schuldgefühle</Text><Value>3</Value></Option></AnswerOptions></Question><Question><Title>Bestrafungsgefühle</Title><Type>Multiple Choice</Type><AnswerOptions><Option><Text>Ich habe nicht das Gefühl, für etwas bestraft zu sein</Text><Value>0</Value></Option><Option><Text>Ich habe das Gefühl, vielleicht bestraft zu werden</Text><Value>1</Value></Option><Option><Text>Ich erwarte, bestraft zu werden</Text><Value>2</Value></Option><Option><Text>Ich habe das Gefühl, bestraft zu sein</Text><Value>3</Value></Option></AnswerOptions></Question><Question><Title>Selbstablehnung</Title><Type>Multiple Choice</Type><AnswerOptions><Option><Text>Ich halte von mir genauso viel wie immer</Text><Value>0</Value></Option><Option><Text>Ich habe Vertrauen in mich verloren</Text><Value>1</Value></Option><Option><Text>Ich bin von mir enttäuscht</Text><Value>2</Value></Option><Option><Text>Ich lehne mich völlig ab</Text><Value>3</Value></Option></AnswerOptions></Question><Question><Title>Selbstvorwürfe</Title><Type>Multiple Choice</Type><AnswerOptions><Option><Text>Ich kritisiere oder tadle mich nicht mehr als sonst</Text><Value>0</Value></Option><Option><Text>Ich bin mir gegenüber kritischer als sonst</Text><Value>1</Value></Option><Option><Text>Ich kritisiere mich für all meine Mängel</Text><Value>2</Value></Option><Option><Text>Ich gebe mir die Schuld für alles Schlimme, was passiert</Text><Value>3</Value></Option></AnswerOptions></Question><Question><Title>Suizidgedanken</Title><Type>Multiple Choice</Type><AnswerOptions><Option><Text>Ich denke nicht daran, mir etwas anzutun</Text><Value>0</Value></Option><Option><Text>Ich denke manchmal an Selbstmord, aber ich würde es nicht tun</Text><Value>1</Value></Option><Option><Text>Ich möchte mich am liebsten umbringen</Text><Value>2</Value></Option><Option><Text>Ich würde mich umbringen, wenn ich die Gelegenheit dazu hätte</Text><Value>3</Value></Option></AnswerOptions></Question><Question><Title>Weinen</Title><Type>Multiple Choice</Type><AnswerOptions><Option><Text>Ich weine nicht öfter als früher</Text><Value>0</Value></Option><Option><Text>Ich weine jetzt mehr als früher</Text><Value>1</Value></Option><Option><Text>Ich weine beim geringsten Anlass</Text><Value>2</Value></Option><Option><Text>Ich möchte gern weinen, aber ich kann nicht</Text><Value>3</Value></Option></AnswerOptions></Question><Question><Title>Unruhe</Title><Type>Multiple Choice</Type><AnswerOptions><Option><Text>Ich bin nicht unruhiger als sonst</Text><Value>0</Value></Option><Option><Text>Ich bin unruhiger als sonst</Text><Value>1</Value></Option><Option><Text>Ich bin so unruhig, dass es mir schwerfällt, stillzusitzen</Text><Value>2</Value></Option><Option><Text>Ich bin so unruhig, dass ich mich ständig bewegen oder etwas tun muss</Text><Value>3</Value></Option></AnswerOptions></Question><Question><Title>Interessensverlust</Title><Type>Multiple Choice</Type><AnswerOptions><Option><Text>Ich habe das Interesse an anderen Menschen oder an Tätigkeiten nicht verloren</Text><Value>0</Value></Option><Option><Text>Ich habe weniger Interesse an anderen Menschen oder an Dingen als sonst</Text><Value>1</Value></Option><Option><Text>Ich habe das Interesse an anderen Menschen oder an Dingen zum größten Teil verloren</Text><Value>2</Value></Option><Option><Text>Es fällt mir schwer, mich überhaupt für irgendetwas zu interessieren</Text><Value>3</Value></Option></AnswerOptions></Question><Question><Title>Entschlusslosigkeit</Title><Type>Multiple Choice</Type><AnswerOptions><Option><Text>Ich bin so entschlussfreudig wie immer</Text><Value>0</Value></Option><Option><Text>Es fällt mir schwerer als sonst, Entscheidungen zu treffen</Text><Value>1</Value></Option><Option><Text>Es fällt mir sehr viel schwerer als sonst, Entscheidungen zu treffen</Text><Value>2</Value></Option><Option><Text>Ich habe Mühe, überhaupt Entscheidungen zu treffen</Text><Value>3</Value></Option></AnswerOptions></Question><Question><Title>Wertlosigkeit</Title><Type>Multiple Choice</Type><AnswerOptions><Option><Text>Ich fühle mich nicht wertlos</Text><Value>0</Value></Option><Option><Text>Ich halte mich für weniger wertvoll und nützlich als sonst</Text><Value>1</Value></Option><Option><Text>Verglichen mit anderen Menschen fühle ich mich viel weniger wert</Text><Value>2</Value></Option><Option><Text>Ich fühle mich völlig wertlos</Text><Value>3</Value></Option></AnswerOptions></Question><Question><Title>Energieverlust</Title><Type>Multiple Choice</Type><AnswerOptions><Option><Text>Ich habe so viel Energie wie immer</Text><Value>0</Value></Option><Option><Text>Ich habe weniger Energie als sonst</Text><Value>1</Value></Option><Option><Text>Ich habe so wenig Energie, dass ich kaum noch etwas schaffe</Text><Value>2</Value></Option><Option><Text>Ich habe keine Energie mehr, um überhaupt noch etwas zu tun</Text><Value>3</Value></Option></AnswerOptions></Question><Question><Title>Schlafgewohnheiten</Title><Type>Multiple Choice</Type><AnswerOptions><Option><Text>Meine Schlafgewohnheiten haben sich nicht verändert</Text><Value>0</Value></Option><Option><Text>Ich schlafe etwas mehr als sonst</Text><Value>1</Value></Option><Option><Text>Ich schlafe etwas weniger als sonst</Text><Value>2</Value></Option><Option><Text>Ich schlafe fast den ganzen Tag</Text><Value>3</Value></Option></AnswerOptions></Question><Question><Title>Reizbarkeit</Title><Type>Multiple Choice</Type><AnswerOptions><Option><Text>Ich bin nicht reizbarer als sonst</Text><Value>0</Value></Option><Option><Text>Ich bin reizbarer als sonst</Text><Value>1</Value></Option><Option><Text>Ich bin viel reizbarer als sonst</Text><Value>2</Value></Option><Option><Text>Ich fühle mich dauernd gereizt</Text><Value>3</Value></Option></AnswerOptions></Question><Question><Title>Veränderungen des Appetits</Title><Type>Multiple Choice</Type><AnswerOptions><Option><Text>Mein Appetit hat sich nicht verändert</Text><Value>0</Value></Option><Option><Text>Mein Appetit ist etwas schlechter als sonst</Text><Value>1</Value></Option><Option><Text>Mein Appetit ist viel schlechter als sonst</Text><Value>2</Value></Option><Option><Text>Ich habe überhaupt keinen Appetit</Text><Value>3</Value></Option></AnswerOptions></Question><Question><Title>Konzentrationsschwierigkeiten</Title><Type>Multiple Choice</Type><AnswerOptions><Option><Text>Ich kann mich so gut konzentrieren wie immer</Text><Value>0</Value></Option><Option><Text>Ich kann mich nicht mehr so gut konzentrieren wie sonst</Text><Value>1</Value></Option><Option><Text>Es fällt mir schwer, mich längere Zeit auf irgendetwas zu konzentrieren</Text><Value>2</Value></Option><Option><Text>Ich kann mich überhaupt nicht mehr konzentrieren</Text><Value>3</Value></Option></AnswerOptions></Question><Question><Title>Ermüdung oder Erschöpfung</Title><Type>Multiple Choice</Type><AnswerOptions><Option><Text>Ich fühle mich nicht müder oder erschöpfter als sonst</Text><Value>0</Value></Option><Option><Text>Ich werde schneller müde oder erschöpft als sonst</Text><Value>1</Value></Option><Option><Text>Für viele Dinge, die ich üblicherweise tue, bin ich zu müde oder erschöpft</Text><Value>2</Value></Option><Option><Text>Ich bin so müde oder erschöpft, dass ich fast nichts mehr tun kann</Text><Value>3</Value></Option></AnswerOptions></Question><Question><Title>Verlust an sexuellem Interesse</Title><Type>Multiple Choice</Type><AnswerOptions><Option><Text>Mein Interesse an Sexualität hat sich in letzter Zeit nicht verändert</Text><Value>0</Value></Option><Option><Text>Ich interessiere mich weniger für Sexualität als früher</Text><Value>1</Value></Option><Option><Text>Ich interessiere mich jetzt viel weniger für Sexualität</Text><Value>2</Value></Option><Option><Text>Ich habe das Interesse an Sexualität völlig verloren</Text><Value>3</Value></Option></AnswerOptions></Question></QuestionGroup></Survey></Limesurvey></document>