   <row>
    <id><![CDATA[20]]></id>
    <gid><![CDATA[20]]></gid>
    <group_name><![CDATA[Stundenbogen für die Allgemeine und Differentielle Einzelpsychotherapie - Version T]]></group_name>
    <description><![CDATA[<meta charset="UTF-8" /><strong>Anleitung</strong>: Bitte lesen Sie die folgenden Aussagen, und beurteilen Sie jeweils, in welchem Maße Sie die heutige Sitzung in der angegebenen Art erlebt haben.Kreuzen Sie dazu jeweils die Antwortkategorie an, die Ihrer persönlichen Meinung am besten, entspricht (von 1 = <em>stimmt überhaupt nicht</em> ... bis ... 7 = <em>stimmt ganz genau</em>).]]></description>
    <language><![CDATA[de]]></language>
    <sid><![CDATA[787794]]></sid>
    <group_order><![CDATA[6]]></group_order>
    <randomization_group/>
    <grelevance/>
   </row>
  </rows>
