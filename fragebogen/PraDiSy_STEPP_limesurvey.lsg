   <row>
    <id><![CDATA[19]]></id>
    <gid><![CDATA[19]]></gid>
    <group_name><![CDATA[Stundenbogen für die Allgemeine und Differentielle Einzelpsychotherapie (STEP) - Version P]]></group_name>
    <description><![CDATA[<strong>Anleitung: </strong>Bitte lesen Sie die folgenden Aussagen, und beurteilen Sie jeweils, in welchem Maße Sie die heutige Sitzung in der angegebenen Art erlebt haben.<br />Kreuzen Sie dazu jeweils die Antwortkategorie an, die Ihrer persönlichen Meinung am besten, entspricht (von 1 = <em>stimmt überhaupt nicht</em> ... bis ... 7 = <em>stimmt ganz genau</em>).]]></description>
    <language><![CDATA[de]]></language>
    <sid><![CDATA[787794]]></sid>
    <group_order><![CDATA[5]]></group_order>
    <randomization_group/>
    <grelevance/>
   </row>
  </rows>
